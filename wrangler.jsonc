{
  // Deploy config for Cloudflare Workers.
  //
  // The site is still plain static HTML/CSS/JS, served straight from assets.
  // src/worker.js only handles what static files can't: the 30-minute cron
  // that posts the scheduled Facebook puzzles (src/posts.json), and
  // /api/social/status. Any request that matches a file is served as before.
  //
  // Secrets (set in the Cloudflare dashboard, never in this file):
  //   FB_PAGE_ID     the BGameWorld Facebook Page ID
  //   FB_PAGE_TOKEN  the never-expiring Page access token
  //   TIKTOK_CLIENT_KEY, TIKTOK_CLIENT_SECRET  from the TikTok developer app
  //   TIKTOK_SETUP_KEY  a password for /api/tiktok/connect (see src/tiktok.js)
  //   PINTEREST_APP_ID, PINTEREST_APP_SECRET, PINTEREST_SETUP_KEY  (see src/pinterest.js)
  //
  // Build step (run by Cloudflare before deploy): none.
  // Deploy step: `npx wrangler deploy`
  "name": "bgameworld-site",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  // "sandbox" while the Pinterest app has Trial access, "production" after Standard access.
  "vars": {
    "PINTEREST_ENV": "sandbox"
  },
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "kv_namespaces": [
    { "binding": "SOCIAL", "id": "d19090c4a37449dd85e97ffe147a8d9d" }
  ]
}
